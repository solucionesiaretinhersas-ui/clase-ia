# Copia este archivo como .env.local y completa los valores de tu proyecto Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → App web).
# En Vercel, créalas en Settings → Environment Variables.
# Si no las defines, la app funciona igual pero sin sincronización en vivo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
